# =============================================================================
# compose 레벨 환경변수 예시.
# 사용법: cp infra/.env.example infra/.env  (infra/.env 는 커밋 금지 → .gitignore)
# 값이 없으면 docker-compose.yml 의 ${VAR:-기본값} 이 적용된다.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=carenote
POSTGRES_PASSWORD=change-me      # 로컬 전용. 실서비스는 Secrets Manager 로.
POSTGRES_DB=carenote
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- App (profile: app) ---
API_PORT=8000
WEB_PORT=3000
